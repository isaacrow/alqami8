        "rdfs:label": [
          {
            "@value": "المخطوطات والنوادر",
            "@language": "ar"
          },
          {
            "@value": "Manuscripts",
            "@language": "en"
          }
        ]
      },
      "bf:originDate": "[200–299 AH] / [800–899 CE]",
      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "أوراق متفرقة من ثلاثة مصاحف جُمعت في مجلد واحد، بالخط الكوفي القديم على الرق بحبر أسود مائل إلى القهوائي. أُدخلت النقاط الحمراء للإعراب لاحقًا، وفُصل بين الآيات بوردة أو ورقة منقوشة بماء الذهب. الورقة المعروضة آخر المجلد، وتنتهي بقوله تعالى: «مَا شَاءَ اللَّهُ لَا قُوَّةَ إِلَّا بِاللَّهِ إِن تَرَنِ» (الكهف 39).",
            "@language": "ar"
          },
          {
            "@value": "Scattered leaves from three Qur'ans bound in one volume, in early Kufic script on parchment in black ink turning brown. The red vowel dots were added later; verses are separated by gold rosettes or leaves. The leaf shown is the last of the volume and ends at Surat al-Kahf 18:39.",
            "@language": "en"
          }
        ]
      },
      "bf:hasInstance": {
        "@id": "https://isaacrow.github.io/alqami6/catalogue/kufic-quran-leaves#instance"
      }
    },
