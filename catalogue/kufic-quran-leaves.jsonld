      "bf:note": [
        {
          "@type": "bf:Note",
          "bf:noteType": "material",
          "rdfs:label": [
            {
              "@value": "رق غزال أصفر فاتح، حبر أسود وأحمر وماء الذهب، خط كوفي قديم",
              "@language": "ar"
            },
            {
              "@value": "Light yellow gazelle parchment; black and red ink and gold; early Kufic script",
              "@language": "en"
            }
          ]
        },
        {
          "@type": "bf:Note",
          "bf:noteType": "condition",
          "rdfs:label": [
            {
              "@value": "أوراق من ثلاثة مصاحف؛ في الورقة المعروضة ثقوب وتآكل في الحواف.",
              "@language": "ar"
            },
            {
              "@value": "Leaves from three manuscripts; the leaf shown has holes and worn edges.",
              "@language": "en"
            }
          ]
        },
        {
          "@type": "bf:Note",
          "bf:noteType": "binding",
          "rdfs:label": [
            {
              "@value": "جلد وكارتون أحمر مؤطر بالذهب، ذو زخرفة غائرة مذهبة",
              "@language": "ar"
            },
            {
              "@value": "Red leather and board, gold-framed, with blind-tooled gilt decoration",
              "@language": "en"
            }
          ]
        },
        {
          "@type": "bf:Note",
          "bf:noteType": "decoration",
          "rdfs:label": [
            {
              "@value": "فواصل آيات بماء الذهب، ودوائر مزخرفة في الهوامش للأحزاب ومواضع السجود",
              "@language": "ar"
            },
            {
              "@value": "Gold verse separators; decorated roundels in the margins for hizb divisions and prostrations (sajda)",
              "@language": "en"
            }
          ]
        },
        {
          "@type": "bf:Note",
          "bf:noteType": "ownership marks",
          "rdfs:label": [
            {
              "@value": "تملك السلطان فتح علي شاه القاجاري (ت 1250 هـ)؛ تملك الفياض الأقدس؛ بلاغ بتاريخ 20 رجب 1200 هـ",
              "@language": "ar"
            },
            {
              "@value": "Ownership notes of Fath Ali Shah Qajar (d. 1250 AH) and al-Fayyad al-Aqdas; a collation note dated 20 Rajab 1200 AH",
              "@language": "en"
            }
          ]
        }
      ],
