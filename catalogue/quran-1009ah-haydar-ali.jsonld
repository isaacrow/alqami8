      "bf:summary": {
        "@type": "bf:Summary",
        "rdfs:label": [
          {
            "@value": "مصحف بخط النسخ في 294 ورقة، مجدول بعدة ألوان، والصفحتان الأولى والثانية مزخرفتان. في صدر كل سورة لوحة ذهبية، وفي الهوامش دوائر مزخرفة لبيان الأحزاب وبداية الأجزاء.",
            "@language": "ar"
          },
          {
            "@value": "A Qur'an in Naskh script on 294 leaves, ruled in several colours, with the first two pages illuminated. Each sura opens with a gold panel; decorated roundels in the margins mark the hizb and juz' divisions.",
            "@language": "en"
          }
        ]
      },
